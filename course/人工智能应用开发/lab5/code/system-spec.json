    "validation_rules": [
      "title must be non‑empty string",
      "attachment_urls must be array of valid URLs",
      "score must be integer between 0 and max_score when decision is approved or rejected",
      "decision allowed values: approved, rejected, needs_resubmission",
      "status transitions must follow workflow: draft -> submitted -> under_review -> (approved|rejected|needs_resubmission) -> graded (if approved)",
      "resubmit_reason required when decision is needs_resubmission",
      "reviewer_id required for status under_review, approved, rejected, or graded"
