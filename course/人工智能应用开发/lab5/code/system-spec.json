      "POST /api/v1/submissions/{id}/submit    # student moves draft to submitted status",
      "GET  /api/v1/submissions?filter={params}# list submissions (student view, teacher queue, admin)",
      "GET  /api/v1/submissions/{id}            # retrieve full submission with history",
      "PATCH /api/v1/submissions/{id}          # teacher adds review data (score, feedback, decision)",
      "POST /api/v1/submissions/{id}/resubmit  # student resubmits after request",
      "GET  /api/v1/metrics                     # dashboard aggregates",
      "GET  /api/v1/labs                        # catalog of labs",
